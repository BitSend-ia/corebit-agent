{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Corebit Agent",
  "version": "0.1.0",
  "identifier": "br.com.corebit.agent",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Corebit Agent",
        "width": 420,
        "height": 640,
        "resizable": false,
        "decorations": false,
        "transparent": false,
        "skipTaskbar": false,
        "visible": false,
        "center": true,
        "alwaysOnTop": false,
        "minimizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost"
    },
    "trayIcon": {
      "id": "main-tray",
      "iconPath": "icons/32x32.png",
      "iconAsTemplate": false,
      "tooltip": "Corebit Agent"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "wix": {
        "language": [
          "pt-BR"
        ]
      },
      "nsis": {
        "installMode": "perMachine",
        "languages": [
          "PortugueseBR"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://cliente.corebit.com.br/downloads/agent/latest.json"
      ],
      "dialog": true,
      "pubkey": "COLOQUE_AQUI_A_CHAVE_PUBLICA_ED25519"
    }
  }
}
